# Template file for 'jellyfin-tui'
pkgname=jellyfin-tui
version=1.5.2
revision=1
archs="x86_64"
build_style=cargo
hostmakedepends="git pkg-config"
makedepends="mpv-devel openssl-devel sqlite-devel"
depends="libcrypto3 libssl3 mpv sqlite"
short_desc="Terminal music streaming client for Jellyfin"
maintainer="askoth <askoth@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/dhonus/jellyfin-tui"
changelog="https://github.com/dhonus/jellyfin-tui/releases"
_gitrev="5b058b4f71444f5a41608f7d95c898ede0016406"	# tag v1.5.2

do_fetch() {
	rm -rf ${wrksrc}
	git clone https://github.com/dhonus/jellyfin-tui ${wrksrc}
	cd ${wrksrc}
	git checkout ${_gitrev}
}

post_install() {
	vlicense LICENSE
}
