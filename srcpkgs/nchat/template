# The error non-PIE executable found in PIE build occurs because Void Linux enforces Position Independent Executable (PIE) security hardening by default.  Since nchat is a pre-compiled binary (you are extracting a tarball, not compiling from source), it was built by the upstream developer without PIE flags, causing the xbps-src hook to reject it.
nopie=yes

do_install() {
	tar -xzf nchat-${version}-linux-x86_64-glibc.tar.gz

	echo mamamia
	ls


	vbin nchat-${version}-linux-x86_64-glibc/bin/nchat

	vdoc nchat-${version}-linux-x86_64-glibc/LICENSE
	vdoc nchat-${version}-linux-x86_64-glibc/THIRD_PARTY_LICENSES

}
