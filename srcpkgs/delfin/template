# Template file for 'delfin'
pkgname=delfin
version=0.4.8
revision=2
archs="x86_64"
build_style=meson
_gitrev="ca81d37496"
configure_args="-Dprofile=release -Dflatpak=false"
hostmakedepends="pkg-config git"
makedepends="ninja gtk4-devel libadwaita-devel mpv-devel rust cargo"
depends="gtk4 libadwaita mpv-devel"
short_desc="Native GTK4 Jellyfin media player - fork from Fisch"
maintainer="askoth <askoth@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://delfin.avery.cafe/"

do_fetch() {
	rm -rf ${wrksrc}
	git clone https://codeberg.org/askoth/delfin.git ${wrksrc}
	cd ${wrksrc}
	git checkout ${_gitrev}
}
